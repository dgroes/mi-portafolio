---
import GmailIcon from "../components/icons/GmailIcon.astro";
import LinkedInIcon from "../components/icons/LinkedInIcon.astro";
import GithubIcon from "../components/icons/GithubIcon.astro";

const EMAIL = "diegopasten78@gmail.com";
---

<footer class="w-full max-w-[1040px] mx-auto py-8 px-4" id="contacto">
  <nav aria-label="Enlaces de contacto">
    <ul class="flex flex-wrap justify-center items-center gap-6 text-gray-200">
      
      <!-- Perfil de LinkedIn -->
      <li>
        <a
          href="https://www.linkedin.com/in/diegopastenuribe/"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 hover:text-yellow-300 transition-colors"
        >
          <LinkedInIcon class="w-8 h-8" />
          <span>Diego Pásten Uribe</span>
        </a>
      </li>

      <!-- Correo electrónico personal -->
      <li>
        <a
          href="mailto:diegopasten78@gmail.com"
          class="flex items-center gap-2 hover:text-yellow-300 transition-colors"
        >
          <GmailIcon class="w-8 h-8" />
          <span>diegopasten78@gmail.com</span>
        </a>
      </li>

      <!-- Perfil de GitHub -->
      <li>
        <a
          href="https://github.com/dgroes"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 hover:text-yellow-300 transition-colors"
        >
          <GithubIcon class="w-8 h-8" />
          <span>dgroes</span>
        </a>
      </li>

    </ul>
  </nav>
</footer>