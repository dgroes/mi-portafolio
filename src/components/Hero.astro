---
import SectionContainer from './SectionContainer.astro';
import Badge from './Badge.astro';
---

<SectionContainer id="hero" class="py-20 sm:py-28">
  <div class="flex flex-col gap-y-4">
    <div class="flex items-center gap-x-4 flex-wrap">
      <h1 class="text-white text-4xl sm:text-6xl font-bold tracking-tight">
        Diego Pastén
      </h1>
      <a
        href="https://linkedin.com/in/diegopastenuribe"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center hover:scale-105 transition-transform"
      >
        <Badge>Disponible para trabajar</Badge>
      </a>
    </div>

    <p class="text-2xl opacity-75 max-w-2xl leading-relaxed">
      Ingeniero en Informática con experiencia en <span class="text-yellow-300/90 font-medium">Desarrollo Web</span>, 
      <span class="text-yellow-300/90 font-medium">QA</span> y <span class="text-yellow-300/90 font-medium">Desarrollo BI</span>. 
      Aportando valor con capacidad de análisis y compromiso con la mejora continua.
    </p>
  </div>
</SectionContainer>