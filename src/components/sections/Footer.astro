---
import GmailIcon from "../icons/GmailIcon.astro";
import LinkIcon from "../icons/LinkIcon.astro";
import GithubIcon from "../icons/GithubIcon.astro";

const EMAIL = "diegopasten78@gmail.com";
---

<footer class="w-full max-w-[1040px] mx-auto py-8 px-4" id="contacto">
  <nav aria-label="Enlaces de contacto">
    <ul class="flex flex-wrap justify-center items-center gap-6 opacity-70">
      
      <!-- Perfil de LinkedIn -->
      <li>
        <a
          href="https://www.linkedin.com/in/diegopastenuribe/"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 hover:text-amber-100 transition-smooth"
        >
          <LinkIcon class="w-4 h-4 sm:w-8 sm:h-8" />
          <span class="text-xs sm:text-sm">Diego Pásten Uribe</span>
        </a>
      </li>

      <!-- Correo electrónico personal -->
      <li>
        <a
          href="mailto:diegopasten78@gmail.com"
          class="flex items-center gap-2 hover:text-amber-100 transition-smooth"
        >
          <GmailIcon class="w-4 h-4 sm:w-8 sm:h-8" />
          <span class="text-xs sm:text-sm">diegopasten78@gmail.com</span>
        </a>
      </li>

      <!-- Perfil de GitHub -->
      <li>
        <a
          href="https://github.com/dgroes"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 hover:text-amber-100 transition-smooth"
        >
          <GithubIcon class="w-4 h-4 sm:w-8 sm:h-8" />
          <span class="text-xs sm:text-sm">dgroes</span>
        </a>
      </li>

    </ul>
  </nav>
</footer>