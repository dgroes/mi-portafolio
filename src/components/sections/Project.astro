---
import SectionContainer from "../SectionContainer.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import ExternallinkIcon from "../icons/ExternallinkIcon.astro";

type Project = CollectionEntry<"projects">;

// 1. Obtener y ordenar proyectos por ID (de más reciente a más antiguo o viceversa)
const projects: Project[] = (await getCollection("projects")).sort(
  (a: Project, b: Project) => b.data.id - a.data.id,
);
---

<SectionContainer id="proyectos" class="">

  <h2 class="text-4xl sm:text-6xl font-bold mb-6 text-amber-50">
    Proyectos
  </h2>

  { projects.map((project: Project) => (
  <article
    class="bg-white/10 backdrop-blur-lg border border-white/10 rounded-2xl
         shadow-lg p-6 mb-4">
    <div>
      <h1 class="text-3xl sm:text-4xl mb-1 text-amber-50 font-thin"> {project.data.title}</h1>

      <p class="text-sm sm:text-xl mb-2 text-amber-50 opacity-75">{project.data.description}</p>

      <!-- Herramientas -->
      <ul class="grid grid-cols-4 gap-4 my-4">
        {project.data.tools.map((too: string) => (
          <li class="text-xs sm:text-lg font-semibold">
            <span set:html={too}></span>
          </li>
        ))}
      </ul>

      

     <a 
      href={project.data.github} 
      target="_blank" 
      rel="noopener noreferrer" 
      class="inline-flex items-center gap-1.5 text-yellow-100 hover:underline hover:text-yellow-200 transition-colors"
    >
      Más sobre el proyecto
      <ExternallinkIcon class="size-4" />
    </a>

    </div>
  </article>
   ))}
</SectionContainer>
