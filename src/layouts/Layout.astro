---
import Footer from "../components/sections/Footer.astro";
import Header from "../components/sections/Header.astro";
import "../styles/global.css";
import "@fontsource-variable/ibm-plex-sans/wght.css";
import "@fontsource-variable/google-sans-code/wght.css";

import "@fontsource-variable/playfair-display/wght.css";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Diego Pastén \ DEV</title>
  </head>
  <body class="aura-bg">
    <div class="aura-layer-1"></div>
    <div class="aura-layer-2"></div>
    <div class="aura-layer-3"></div>
    <div class="aura-layer-4"></div>

    <div class="aura-content">
      <!-- <Header /> -->
      <slot />
      <Footer />
    </div>
  </body>
</html>

<style>
  :root {
    color-scheme: light dark; /* Por defecto se indica que será de fondo oscuro y texto claro */
  }

  html {
    font-family: "Google Sans Code Variable", monospace;
  }

  h1,
  h2 {
    font-family: "Playfair Display Variable", serif;
  }

  body {
